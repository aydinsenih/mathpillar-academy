# ==============================================================================
# MathPillar Academy - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to configure your environment variables.

# ------------------------------------------------------------------------------
# 1. SQLite Database Configuration
# ------------------------------------------------------------------------------
# In Local Development:
# Defaults to: ./src/data/mathpillar.sqlite
DATABASE_PATH=./src/data/mathpillar.sqlite

# In Docker / Coolify / Production:
# The Dockerfile defaults to /app/data/mathpillar.sqlite.
# To use a custom path or mounted volume location in Docker, set:
# DATABASE_PATH=/app/data/mathpillar.sqlite

# Alternatively, configure directory only (file will default to mathpillar.sqlite):
# DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. Admin Authentication (/admin)
# ------------------------------------------------------------------------------
# Login email for the admin management dashboard
ADMIN_EMAIL=admin@mathpillar.com

# Password for the admin dashboard (CHANGE THIS in production!)
ADMIN_PASSWORD=admin123

# Secret token used for session cookies (CHANGE THIS to a random secure string!)
ADMIN_SESSION_TOKEN=mp_auth_secret_token_2026

# ------------------------------------------------------------------------------
# 3. Server & Network
# ------------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
